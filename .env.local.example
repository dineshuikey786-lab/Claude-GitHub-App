# Copy to .env.local, then run: npm run dev:local
# .env.local is ignored by git. Never commit real keys.

# The account you sign in with on the local sign-in screen.
MATAI_LOCAL_NAME=admin
MATAI_LOCAL_PIN=1234

# Your own Kie.ai API key (https://kie.ai/api-key). Needed to generate.
KIE_API_KEY=

# Optional: fal.ai key (large video uploads, FLUX Kontext / LoRA, avatar training).
FAL_KEY=

# Optional: ElevenLabs key for cloned-voice voiceovers.
ELEVENLABS_API_KEY=
